# Dependencies
node_modules/
.pnp
.pnp.*

# Builds (incl. separate dist dirs like .next-build, .next-sec)
.next/
.next-*/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Env files (never commit secrets)
.env
.env.*
!.env.example

# Test output
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local databases
*.db
*.sqlite
*.sqlite3

# Claude Code local state
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# Gigs and projects are personal output; publish one with `git add -f`
gigs/*
!gigs/.gitkeep
projects/*
!projects/.gitkeep
!projects/agent-os/

# Agent memories are per user (lessons reveal what you worked on); see .claude/agent-memory/README.md
.claude/agent-memory/*/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Temp
tmp/
temp/
*.tmp
